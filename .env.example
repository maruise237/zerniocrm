# ─────────────────────────────────────────────────────────────
# ZernioCRM — Variables d'environnement
# Copier ce fichier : cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# ── Base de données (Neon Postgres) ─────────────────────────
# Requis pour : config Zernio par utilisateur, webhook, journal messages
# Sans cette variable, l'app tourne en « mode local » dégradé.
# Sur Vercel, utilisez l'URL POOLED de Neon (suffixe -pooler) :
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require

# ── Authentification (Neon Auth / Better Auth managé) ───────
# URL de l'instance Neon Auth (défaut : https://auth.neon.tech)
NEON_AUTH_BASE_URL=https://auth.neon.tech
# Secret de signature des cookies de session (32+ caractères)
# Générer : openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=remplacez-moi-par-une-chaine-secrete-de-32-caracteres-minimum

# ── Application ──────────────────────────────────────────────
# URL publique de l'application (utilisée pour construire l'URL webhook)
APP_URL=http://localhost:4100

# ── Zernio ───────────────────────────────────────────────────
# URL de l'API Zernio (défaut : https://zernio.com/api)
ZERNIO_API_URL=https://zernio.com/api
# Clé API globale du SERVEUR — uniquement pour les routes proxy
# (contacts, conversations, templates, flows, broadcasts…)
# La clé personnelle de chaque utilisateur reste saisie dans /settings.
ZERNIO_API_KEY=

# ── Développement local uniquement ───────────────────────────
# Fallback d'identification quand Neon Auth n'est pas encore connecté.
# Ne JAMAIS définir en production.
DEMO_USER_ID=

# ── Optionnel ────────────────────────────────────────────────
# Activer l'appel WhatsApp dans le fil (true/false)
NEXT_PUBLIC_WHATSAPP_CALLING_ENABLED=false
